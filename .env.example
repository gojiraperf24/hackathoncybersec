DATABASE_URL=postgresql+psycopg://civic:civic@localhost:5432/civic

# X (Twitter) API v2 — bearer token
X_BEARER_TOKEN=your_x_bearer_token

# YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_key

# S3 / MinIO for media
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=civic-media
S3_REGION=us-east-1

# Media download limits
MAX_MEDIA_BYTES=52428800S